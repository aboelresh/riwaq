APP_NAME=Riwaq
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.Riwaq.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging — stack = daily + errors channels
LOG_CHANNEL=stack
LOG_STACK=daily,errors
LOG_LEVEL=error

# Database — MySQL 8.4
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Riwaq_production
DB_USERNAME=Riwaq_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Cache + Queue — Redis for production performance
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

# JWT
JWT_SECRET=GENERATE_WITH_php_artisan_jwt:secret
JWT_TTL=60

# Mail — use real SMTP in production
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@Riwaq.com
MAIL_PASSWORD=CHANGE_ME
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=noreply@Riwaq.com
MAIL_FROM_NAME=Riwaq

# CORS — restrict to your actual frontend URLs
CORS_ALLOWED_ORIGINS=https://Riwaq.com,https://app.Riwaq.com

# AI Provider — choose one
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME

# Broadcasting — Laravel Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# IMPORTANT: These MUST be set before going live
# 1. APP_KEY — php artisan key:generate
# 2. JWT_SECRET — php artisan jwt:secret
# 3. DB_PASSWORD — strong random password
# 4. All CHANGE_ME values above

# Production Seed Config (used by ProductionSeeder)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DEFAULT_ORG_SLUG=default
DEFAULT_ORG_SUBDOMAIN=app