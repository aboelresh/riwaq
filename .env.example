APP_NAME=CodeMaster
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────
# SQLite (default for local dev)
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# MySQL (recommended for production)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=codemaster
# DB_USERNAME=root
# DB_PASSWORD=

# ── Cache & Session ───────────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Queue ────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
# Use redis in production:
# QUEUE_CONNECTION=redis

# ── Redis ────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@codemaster.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── JWT ──────────────────────────────────────────────────────────
# Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# ── AI Provider ──────────────────────────────────────────────────
# Options: gemini, openai, claude, groq
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Use * for local dev only — restrict in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Broadcasting (Laravel Reverb) ────────────────────────────────
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ── SaaS / Multi-tenancy ─────────────────────────────────────────
# Set to true for Single License deployment (always uses org #1)
SINGLE_LICENSE_MODE=false
SINGLE_LICENSE_ORGANIZATION_ID=1

# Base domain for subdomain-based tenant resolution
APP_BASE_DOMAIN=codemaster.com

# ── Filesystem ───────────────────────────────────────────────────
FILESYSTEM_DISK=local